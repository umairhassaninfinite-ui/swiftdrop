# Local development only. Copy to .env; generate ignored keys before starting.
NODE_ENV=development
PORT=3000
INTERNAL_PORT=3001
APP_ORIGIN=http://localhost:5173
API_ISSUER=http://localhost:3000
HUMAN_AUDIENCE=swiftdrop-web
SERVICE_ISSUER=http://127.0.0.1:3001
DATABASE_URL=postgresql://swiftdrop:local-development-only@localhost:5432/swiftdrop
REDIS_URL=redis://localhost:6380
RABBITMQ_URL=amqp://guest:guest@localhost:5672
AUTH_PRIVATE_KEY_FILE=.local/auth/private.pem
AUTH_PUBLIC_KEYS_FILE=.local/auth/public-keys.json
AUTH_KEY_ID=local-1
CSRF_SECRET_FILE=.local/auth/csrf.key
RATE_LIMIT_SECRET_FILE=.local/auth/rate-limit.key
OAUTH_TRANSACTION_SECRET_FILE=.local/auth/oauth.key
COOKIE_SECURE=false
CUSTOMER_IDLE_SECONDS=604800
CUSTOMER_ABSOLUTE_SECONDS=2592000
STAFF_IDLE_SECONDS=43200
STAFF_ABSOLUTE_SECONDS=86400
# Local-only Mailpit SMTP. Production must use its private secret store and approved relay.
SMTP_URL=smtp://localhost:1025
# Reserved for later phases.
# MERCHANT_AUDIENCE=swiftdrop-merchant
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# When enabled, set callback URL to http://localhost:5173/api/v1/auth/google/callback
# MFA_ENCRYPTION_KEY_FILE=
# MAIL_ENCRYPTION_KEY_FILE=
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=swiftdrop
MINIO_SECRET_KEY=local-development-only
MINIO_BUCKET=swiftdrop-receipts

# --- M08 eventing and webhooks (outbox-relay, webhook-svc) ---
# Both read DATABASE_URL and RABBITMQ_URL above. Production needs a dedicated RabbitMQ credential.
OUTBOX_RELAY_PORT=3101
OUTBOX_POLL_INTERVAL_MS=1000
WEBHOOK_SVC_PORT=3102
# Development only (refused in production): a JSON file {"<merchantId>": {"url": "...", "secret": "<16+ chars>"}}
# standing in for M02's merchant webhook configuration, and hosts allowed to receive plain HTTP.
# WEBHOOK_DEV_CONFIG_FILE=.local/webhooks/targets.json   (keys are merchant UUIDs)
# WEBHOOK_DEV_ALLOWED_HOSTS=localhost

# --- M09 notifications and realtime ---
# notification-svc reads DATABASE_URL, RABBITMQ_URL and SMTP_URL (Mailpit) above. It signs a
# per-event service JWT with the key written by: pnpm services:provision --service notification-svc
NOTIFICATION_SVC_PORT=3103
CORE_INTERNAL_URL=http://127.0.0.1:3001
NOTIFICATION_SIGNER_FILE=.local/services/notification-svc/signer.json
# webhook-svc reads merchant webhook URL/secret from core-api (X-11) with the key written by:
#   pnpm services:provision --service webhook-svc
WEBHOOK_SIGNER_FILE=.local/services/webhook-svc/signer.json
# Socket.IO is served by core-api on its public port (/socket.io) and shares rooms through REDIS_URL.

# --- Containers / reverse proxy / AI assistant ---
# core-api binds loopback by default. Containers set HOST=0.0.0.0 (INTERNAL_HOST too); the internal
# port (INTERNAL_PORT) must never be published or routed by nginx / the Ingress.
# HOST=127.0.0.1
# INTERNAL_HOST=127.0.0.1
# Number of trusted proxy hops in front of core-api (nginx / Ingress = 1) so per-IP rate limits
# see real client addresses. Leave 0 when nothing proxies in front of the API.
# TRUST_PROXY=0
# When set, GET /api/ready also reports outbox-relay (503 "degraded" if it is down).
OUTBOX_RELAY_URL=http://127.0.0.1:3101
# ai-assistant: MCP server (streamable HTTP at POST /mcp). Its tools call core-api's REST API with
# the caller's own JWT and are read-only.
AI_ASSISTANT_PORT=5000
CORE_API_URL=http://127.0.0.1:3000
# docker compose only: SD_APP_ORIGIN (default http://localhost), SD_COOKIE_SECURE, SD_HTTP_PORT,
# SD_HTTPS_PORT and SD_ENABLE_TLS change the gateway (prefixed so they never clash with the
# APP_ORIGIN used by `pnpm dev`); see compose.yaml.
