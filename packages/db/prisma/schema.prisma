generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}
datasource db {
  provider = "postgresql"
}
enum RoleName {
  CUSTOMER
  MERCHANT
  COURIER
  DISPATCHER
  ADMIN
}
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}
enum ParcelStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}
model Role {
  id    RoleName @id
  users User[]
  @@map("roles")
}
model User {
  id           Int @id @default(autoincrement())
  email        String @unique @db.VarChar(254)
  passwordHash String? @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  fullName     String? @map("full_name") @db.VarChar(120)
  phone        String? @db.VarChar(16)
  googleSub    String? @unique @map("google_sub") @db.VarChar(255)
  roleId       RoleName @map("role_id")
  role         Role @relation(fields: [roleId], references: [id], onDelete: NoAction)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     AuthSession[]
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  mfaFactor MfaFactor?
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges MfaChallenge[]
  staffInvitations StaffInvitation[]
  oauthTransactions OAuthTransaction[]
  quotes Quote[]
  parcels Parcel[]
  merchant Merchant?
  reviewedMerchants Merchant[] @relation("MerchantReviewer")
  courierProfile CourierProfile?
  @@map("users")
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
}

model Merchant {
  id           String         @id @default(uuid()) @db.Uuid
  userId       Int            @unique @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String         @map("business_name") @db.VarChar(160)
  status       MerchantStatus @default(PENDING)
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewedById Int?           @map("reviewed_by_id")
  reviewedBy   User?          @relation("MerchantReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  apiClients   MerchantApiClient[]
  parcels      Parcel[]             @relation("MerchantOrders")
  webhookConfig MerchantWebhookConfig?
  @@index([status, createdAt, id])
  @@map("merchants")
}

model MerchantApiClient {
  id           String    @id @default(uuid()) @db.Uuid
  merchantId   String    @map("merchant_id") @db.Uuid
  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  clientId     String    @unique @map("client_id") @db.VarChar(64)
  name         String    @db.VarChar(80)
  secretHash   String    @map("secret_hash") @db.Char(64)
  scopes       String[]  @default([])
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  rotatedAt    DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  accessGrants AccessGrant[]
  @@index([merchantId, createdAt, id])
  @@map("merchant_api_clients")
}

model MerchantWebhookConfig {
  merchantId String   @id @map("merchant_id") @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  url        String   @db.VarChar(2048)
  encryptedSecret String @map("encrypted_secret") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("merchant_webhook_configs")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  generation Int
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId, generation])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Security trail (auth plan section 6). The user ids are plain integers, not foreign keys, so
// deleting an account never deletes the record of what happened to it. Metadata is a small,
// whitelisted set of primitives (see apps/core-api/src/modules/auth/audit.ts); never secrets.
model AuthAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  eventType     String   @map("event_type") @db.VarChar(40)
  outcome       String   @db.VarChar(8)
  actorUserId   Int?     @map("actor_user_id")
  targetUserId  Int?     @map("target_user_id")
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  metadata      Json     @default("{}")
  @@index([occurredAt])
  @@index([targetUserId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("auth_audit_events")
}

// One TOTP factor per user. The secret is AES-256-GCM encrypted under a dedicated key
// (key_version names it, so the key can be rotated); a factor is usable only once confirmed.
// last_used_step is the newest accepted 30 second time step: a code can never be replayed.
model MfaFactor {
  id              String    @id @default(uuid()) @db.Uuid
  userId          Int       @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedSecret String    @map("encrypted_secret") @db.Text
  keyVersion      Int       @map("key_version")
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId])
  @@map("mfa_recovery_codes")
}

// Opaque, short-lived step between the password and the second factor. It carries no access.
model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@index([userId])
  @@map("mfa_challenges")
}

model StaffInvitation {
  id         String   @id @default(uuid()) @db.Uuid
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  generation Int
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([userId, generation])
  @@index([expiresAt])
  @@map("staff_invitations")
}

model Zone {
  id        Int      @id @default(autoincrement())
  district  String   @unique @db.VarChar(80)
  town      String   @db.VarChar(80)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  originPrices PriceVersion[] @relation("OriginPrices")
  destinationPrices PriceVersion[] @relation("DestinationPrices")
  originQuotes Quote[] @relation("QuoteOrigin")
  destinationQuotes Quote[] @relation("QuoteDestination")
  originParcels Parcel[] @relation("ParcelOrigin")
  destinationParcels Parcel[] @relation("ParcelDestination")
  @@map("zones")
}

model PriceVersion {
  id Int @id @default(autoincrement())
  originZoneId Int @map("origin_zone_id")
  destinationZoneId Int @map("destination_zone_id")
  originZone Zone @relation("OriginPrices", fields: [originZoneId], references: [id], onDelete: Restrict)
  destinationZone Zone @relation("DestinationPrices", fields: [destinationZoneId], references: [id], onDelete: Restrict)
  baseCents Int @map("base_cents")
  perExtraKgCents Int @map("per_extra_kg_cents")
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  quotes Quote[]
  @@unique([originZoneId, destinationZoneId, effectiveFrom])
  @@index([originZoneId, destinationZoneId, effectiveFrom])
  @@map("price_versions")
}

model Quote {
  id String @id @default(uuid()) @db.Uuid
  userId Int @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  originZoneId Int @map("origin_zone_id")
  destinationZoneId Int @map("destination_zone_id")
  originZone Zone @relation("QuoteOrigin", fields: [originZoneId], references: [id], onDelete: Restrict)
  destinationZone Zone @relation("QuoteDestination", fields: [destinationZoneId], references: [id], onDelete: Restrict)
  priceVersionId Int @map("price_version_id")
  priceVersion PriceVersion @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  weightGrams Int @map("weight_grams")
  lengthMm Int @map("length_mm")
  widthMm Int @map("width_mm")
  heightMm Int @map("height_mm")
  feeCents Int @map("fee_cents")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  parcel Parcel?
  @@index([userId, expiresAt])
  @@map("quotes")
}

model Parcel {
  id String @id @default(uuid()) @db.Uuid
  trackingNumber String @unique @map("tracking_number") @db.VarChar(16)
  userId Int @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchantId String? @map("merchant_id") @db.Uuid
  merchant Merchant? @relation("MerchantOrders", fields: [merchantId], references: [id], onDelete: Restrict)
  quoteId String @unique @map("quote_id") @db.Uuid
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  originZoneId Int @map("origin_zone_id")
  destinationZoneId Int @map("destination_zone_id")
  originZone Zone @relation("ParcelOrigin", fields: [originZoneId], references: [id], onDelete: Restrict)
  destinationZone Zone @relation("ParcelDestination", fields: [destinationZoneId], references: [id], onDelete: Restrict)
  status ParcelStatus @default(CREATED)
  feeCents Int @map("fee_cents")
  version Int @default(1)
  attemptCount Int @default(0) @map("attempt_count")
  recipientName String @map("recipient_name") @db.VarChar(120)
  recipientPhone String @map("recipient_phone") @db.VarChar(16)
  recipientAddress String @map("recipient_address") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  history ParcelHistory[]
  receipt Receipt?
  assignment ParcelAssignment?
  courierOperations CourierOperation[]
  @@index([userId, createdAt, id])
  @@index([merchantId, createdAt, id])
  @@map("parcels")
}

// M06: one row per courier user. `workload` is the number of unreleased assignments and is only
// changed while holding the row lock (SELECT ... FOR UPDATE, rows locked in ascending user_id
// order, then the parcel row) by assignment, reassignment, cancellation and final delivery.
model CourierProfile {
  userId Int @id @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  onDuty Boolean @default(false) @map("on_duty")
  capacity Int @default(10)
  workload Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments ParcelAssignment[]
  operations CourierOperation[]
  @@map("courier_profiles")
}

// M06: the current courier of a parcel. One row per parcel; `released_at` is set when the parcel
// stops being active (delivered, cancelled, finally failed) so capacity is returned exactly once.
model ParcelAssignment {
  parcelId String @id @map("parcel_id") @db.Uuid
  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  courierId Int @map("courier_id")
  courier CourierProfile @relation(fields: [courierId], references: [userId], onDelete: Restrict)
  assignedById Int @map("assigned_by_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  releaseReason String? @map("release_reason") @db.VarChar(24)
  @@index([courierId, releasedAt])
  @@map("parcel_assignments")
}

// M07: ledger of courier status updates. The unique (courier, operation key) makes a replayed
// offline update return the original result instead of applying twice. Proof metadata lives here.
model CourierOperation {
  id String @id @default(uuid()) @db.Uuid
  courierId Int @map("courier_id")
  courier CourierProfile @relation(fields: [courierId], references: [userId], onDelete: Restrict)
  operationKey String @map("operation_key") @db.VarChar(64)
  requestHash String @map("request_hash") @db.Char(64)
  parcelId String @map("parcel_id") @db.Uuid
  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  toStatus ParcelStatus @map("to_status")
  receivedBy String? @map("received_by") @db.VarChar(120)
  failureReason String? @map("failure_reason") @db.VarChar(32)
  proofObjectKey String? @map("proof_object_key") @db.VarChar(255)
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([courierId, operationKey])
  @@index([parcelId, createdAt])
  @@map("courier_operations")
}

model ParcelHistory {
  id BigInt @id @default(autoincrement())
  parcelId String @map("parcel_id") @db.Uuid
  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  status ParcelStatus
  town String @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([parcelId, createdAt, id])
  @@map("parcel_history")
}

model Receipt {
  id              String   @id @default(uuid()) @db.Uuid
  parcelId        String   @unique @map("parcel_id") @db.Uuid
  parcel          Parcel   @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  reference       String   @unique @db.VarChar(40)
  objectKey       String   @unique @map("object_key") @db.VarChar(255)
  generatedAt     DateTime @map("generated_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("parcel_receipts")
}

model IdempotencyRecord {
  id String @id @default(uuid()) @db.Uuid
  principalKey String @map("principal_key") @db.VarChar(64)
  operation String @db.VarChar(80)
  key String @db.VarChar(128)
  requestHash String @map("request_hash") @db.Char(64)
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@unique([principalKey, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(100)
  aggregateId String @map("aggregate_id") @db.Uuid
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts Int @default(0)
  correlationId String? @map("correlation_id") @db.VarChar(64)
  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}
enum WebhookAttemptState {
  CLAIMED
  DONE
}
enum WebhookAttemptOutcome {
  SUCCESS
  FAILURE
  SKIPPED
}
enum WebhookHandoff {
  NONE
  RETRY
  DLQ
}

// M08: one row per (event, merchant). `envelope` is the original PII-free event, re-signed on
// every attempt. A replay is a new run (`current_run`) of the same row, keeping the eventId.
model WebhookDelivery {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(100)
  envelope Json
  status WebhookDeliveryStatus @default(PENDING)
  currentRun Int @default(0) @map("current_run")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  attempts WebhookAttempt[]
  replays WebhookReplay[]
  @@unique([eventId, merchantId])
  @@index([status, createdAt, id])
  @@index([merchantId, createdAt, id])
  @@map("webhook_deliveries")
}

// The unique (delivery, run, attempt) key is the claim: a duplicate message cannot start a
// second attempt, and a redelivered one resumes the stored result instead of re-sending.
model WebhookAttempt {
  id BigInt @id @default(autoincrement())
  deliveryId String @map("delivery_id") @db.Uuid
  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  runNumber Int @map("run_number")
  attempt Int
  state WebhookAttemptState @default(CLAIMED)
  leaseUntil DateTime @map("lease_until") @db.Timestamptz(3)
  outcome WebhookAttemptOutcome?
  statusCode Int? @map("status_code")
  latencyMs Int? @map("latency_ms")
  errorCode String? @map("error_code") @db.VarChar(64)
  handoff WebhookHandoff @default(NONE)
  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz(3)
  handoffConfirmedAt DateTime? @map("handoff_confirmed_at") @db.Timestamptz(3)
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  @@unique([deliveryId, runNumber, attempt])
  @@map("webhook_attempts")
}

// Audit record of an Admin replay. requested_by_user_id is deliberately not a foreign key so
// the audit row survives user changes and this slice does not edit the identity model.
model WebhookReplay {
  id String @id @default(uuid()) @db.Uuid
  deliveryId String @map("delivery_id") @db.Uuid
  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  runNumber Int @map("run_number")
  requestedByUserId Int @map("requested_by_user_id")
  reason String @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([deliveryId, runNumber])
  @@map("webhook_replays")
}

// M09: per-consumer progress keyed by eventId. DONE means every message for the event was handled,
// so a redelivery is suppressed. PROCESSING carries a lease so a crashed worker can be taken over.
model ProcessedEvent {
  id String @id @default(uuid()) @db.Uuid
  consumer String @db.VarChar(80)
  eventId String @map("event_id") @db.Uuid
  status String @db.VarChar(16)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([consumer, eventId])
  @@map("processed_events")
}

// M09: one row per (event, channel, template) holding the latest outcome. Only masked recipients
// are stored (NFR-4). A SENT row stops a retried event from sending the same message twice.
model NotificationLog {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  channel String @db.VarChar(8)
  templateId String @map("template_id") @db.VarChar(80)
  recipientMasked String @map("recipient_masked") @db.VarChar(254)
  status String @db.VarChar(8)
  providerMsgId String? @map("provider_msg_id") @db.VarChar(255)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
  errorMsg String? @map("error_msg") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([eventId, channel, templateId])
  @@map("notification_logs")
}

model ConsumerProgress {
  eventId String @id @map("event_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(100)
  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamptz(3)
  @@map("consumer_progress")
}

model ServicePrincipal {
  serviceId    String           @id @map("service_id") @db.VarChar(80)
  serviceKind  String           @map("service_kind") @db.VarChar(32)
  audience     String           @db.VarChar(120)
  permissions  String[]         @default([])
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  keys         ServicePublicKey[]
  @@map("service_principals")
}

model ServicePublicKey {
  keyId        String           @id @map("key_id") @db.VarChar(80)
  serviceId    String           @map("service_id") @db.VarChar(80)
  principal    ServicePrincipal @relation(fields: [serviceId], references: [serviceId], onDelete: Cascade)
  publicKeyPem String           @map("public_key_pem") @db.Text
  notBefore    DateTime         @map("not_before") @db.Timestamptz(3)
  notAfter     DateTime?        @map("not_after") @db.Timestamptz(3)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([serviceId, notBefore, notAfter])
  @@map("service_public_keys")
}
model VerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  generation Int
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("verification_tokens")
}
model OAuthTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  stateHash         String   @unique @map("state_hash") @db.Char(64)
  nonce             String   @db.VarChar(128)
  encryptedVerifier String   @map("encrypted_verifier") @db.Text
  browserHash       String   @map("browser_hash") @db.Char(64)
  intent            String   @db.VarChar(8)
  userId            Int?     @map("user_id")
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId          String?  @map("family_id") @db.Uuid
  passwordHash      String?  @map("password_hash") @db.Text
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("oauth_transactions")
}
model AuthSession {
  id                String @id @default(uuid()) @db.Uuid
  userId            Int @map("user_id")
  user              User @relation(fields: [userId], references: [id], onDelete: NoAction)
  roleAtAuthentication RoleName @map("role_at_authentication")
  authenticatedAt   DateTime @default(now()) @map("authenticated_at") @db.Timestamptz(3)
  lastRefreshedAt   DateTime @default(now()) @map("last_refreshed_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revocationReason  String? @map("revocation_reason") @db.VarChar(32)
  reauthenticatedAt DateTime? @map("reauthenticated_at") @db.Timestamptz(3)
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  refreshTokens     RefreshToken[]
  accessGrants      AccessGrant[]
  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("auth_sessions")
}
model RefreshToken {
  id         String @id @default(uuid()) @db.Uuid
  tokenHash  String @unique @map("token_hash") @db.Char(64)
  familyId   String @map("family_id") @db.Uuid
  family     AuthSession @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parentId   String? @unique @map("parent_id") @db.Uuid
  parent     RefreshToken? @relation("Rotation", fields: [parentId], references: [id], onDelete: NoAction)
  successor  RefreshToken? @relation("Rotation")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  @@index([familyId])
  @@map("refresh_tokens")
}
model AccessGrant {
  jti       String @id @db.Uuid
  familyId  String? @map("family_id") @db.Uuid
  family    AuthSession? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  clientId  String? @map("client_id") @db.Uuid
  client    MerchantApiClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([familyId])
  @@index([clientId])
  @@index([expiresAt])
  @@map("access_grants")
}
